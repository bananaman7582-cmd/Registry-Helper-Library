{
	"schemaVersion": 1,
	"id": "registry-helper-library",
	"version": "${version}",
	"name": "Registry Helper Library",
	"description": "A small Fabric API library that simplifies registering items, blocks, and armor by wrapping Minecraft's registry system in a few clean, overloaded methods, cutting down repetitive boilerplate while staying fully backward-compatible.",
	"authors": [
		"Bananaman"
	],
	"contact": {
		"homepage": "https://modrinth.com/project/registry-helper-library",
		"sources": "https://github.com/bananaman7582-cmd/Registry-Helper-Library"
	},
	"license": "CC0-1.0",
	"icon": "assets/registry-helper-library/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.bananaman.RegistryHelperLibrary"
		],
		"client": [
			"com.bananaman.client.RegistryHelperLibraryClient"
		]
	},
	"depends": {
		"fabricloader": ">=0.16.10",
		"minecraft": "~1.20.1",
		"java": ">=17",
		"fabric-api": "*"
	}
}